# Copy to .env and fill in (docs/setup.md, step 2). .env is never committed.

# The server's MagicDNS name: tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//'
SERVER_NAME=server.tailXXXX.ts.net

# The server's address on the home network (for "Open on home network" links)
LAN_IP=192.168.1.10

# Immich's Tailscale Service name (same tailnet part as SERVER_NAME)
IMMICH_HOST=immich.tailXXXX.ts.net

# OpenCloud's Tailscale Service name (apps/opencloud)
OPENCLOUD_HOST=opencloud.tailXXXX.ts.net
