# Auth/gateway/caddy/Caddyfile
# {$SERVER_NAME} and {$LAN_IP} come from .env via docker-compose.yml.

{
	admin off
	servers {
		# Trust forwarded headers from tailscale serve (arrives via the Docker bridge),
		# so Authelia sees the real client address instead of one shared address.
		trusted_proxies static private_ranges
	}
}

# tailscale serve terminates HTTPS and talks plain HTTP to Caddy.
# These headers tell Authelia the original request was HTTPS on the real name.
(original_request) {
	header_up X-Forwarded-Proto https
	header_up X-Forwarded-Host {$SERVER_NAME}
}

:8080 {
	# Authelia's login portal and API
	handle /auth* {
		reverse_proxy authelia:9091 {
			import original_request
		}
	}

	# Protected test app: only reachable after login
	handle /whoami* {
		forward_auth authelia:9091 {
			uri /auth/api/authz/forward-auth
			import original_request
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy whoami:80
	}

	# Machine-specific values for the landing page, so they stay out of the repository
	handle /config.json {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"serverName":"{$SERVER_NAME}","lanIp":"{$LAN_IP}"}` 200
	}

	# Landing page: public, so guests see the app panel
	handle {
		root * /srv/landing
		file_server
	}
}