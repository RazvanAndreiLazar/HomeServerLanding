# Copy to .env (scripts/setup.sh does this) and fill in. .env is never committed.

# The server's MagicDNS name (same as SERVER_NAME in gateway/.env)
SERVER_NAME=server.tailXXXX.ts.net

# code-server's Tailscale Service name (same tailnet part as SERVER_NAME)
CODE_SERVER_HOST=code-server.tailXXXX.ts.net

# Where code-server keeps its settings and extensions (config/, local/)
CODE_SERVER_DATA_DIR=/srv/data/code-server

# The folder code-server opens (your projects). Must be owned by CODE_SERVER_UID_GID.
CODE_SERVER_PROJECTS_DIR=/home/user/projects

# code-server runs as this user and group, so files keep your ownership. setup.sh fills in yours.
CODE_SERVER_UID_GID=1000:1000
CODE_SERVER_USER=coder

# oauth2-proxy's client secret for Authelia (the plain one; Authelia only has its digest)
# and the key for its session cookie. setup.sh generates both.
CODE_SERVER_CLIENT_SECRET=
CODE_SERVER_COOKIE_SECRET=

# Only if the container can't resolve SERVER_NAME (see docker-compose.yml): tailscale ip -4
SERVER_TAILSCALE_IP=
