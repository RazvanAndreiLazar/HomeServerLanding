# Copy to .env (scripts/setup.sh does this) and fill in. .env is never committed.

# The server's MagicDNS name (same as SERVER_NAME in gateway/.env)
SERVER_NAME=server.tailXXXX.ts.net

# OpenCloud's Tailscale Service name (same tailnet part as SERVER_NAME)
OPENCLOUD_HOST=opencloud.tailXXXX.ts.net

# Where OpenCloud keeps its generated config (secrets!) and the users' files.
# Put the data on the data disk; both must be owned by OC_UID_GID.
OPENCLOUD_CONFIG_DIR=/srv/opencloud/config
OPENCLOUD_DATA_DIR=/mnt/data/opencloud
OC_UID_GID=1000:1000

# Password for OpenCloud's built-in "admin" account (maintenance only). setup.sh generates one.
OC_ADMIN_PASSWORD=

OC_DEFAULT_LANGUAGE=en

# Only if the container can't resolve SERVER_NAME (see docker-compose.yml): tailscale ip -4
SERVER_TAILSCALE_IP=
