# Copy to .env (scripts/setup.sh does this) and fill in. .env is never committed.

# The server's MagicDNS name (same as SERVER_NAME in gateway/.env)
SERVER_NAME=server.tailXXXX.ts.net

# Jellyfin's Tailscale Service name (same tailnet part as SERVER_NAME)
JELLYFIN_HOST=jellyfin.tailXXXX.ts.net

# Where Jellyfin keeps its database, users and plugins (config) and its transcodes and images
# (cache; SSD preferred). Both must be owned by JELLYFIN_UID_GID.
JELLYFIN_CONFIG_DIR=/srv/jellyfin/config
JELLYFIN_CACHE_DIR=/srv/jellyfin/cache

# The media library (films, series, music), mounted read-only. JELLYFIN_UID_GID must be able to read it.
JELLYFIN_MEDIA_DIR=/srv/data/media

# Jellyfin runs as this user and group. setup.sh fills in yours.
JELLYFIN_UID_GID=1000:1000

# Only if the container can't resolve SERVER_NAME (see docker-compose.yml): tailscale ip -4
SERVER_TAILSCALE_IP=
