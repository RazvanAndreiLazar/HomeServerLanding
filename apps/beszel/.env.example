# Copy to .env (scripts/setup.sh does this) and fill in. .env is never committed.

# The server's MagicDNS name (same as SERVER_NAME in gateway/.env)
SERVER_NAME=server.tailXXXX.ts.net

# Beszel's Tailscale Service name (same tailnet part as SERVER_NAME)
BESZEL_HOST=beszel.tailXXXX.ts.net

# Where Beszel keeps its database (systems, history, users) and its SSH key for the agent
BESZEL_DATA_DIR=/srv/data/beszel

# First Beszel user, created on the very first start. The email must be the admin's email in
# gateway/authelia/config/users_database.yml. The password is only for Beszel's admin UI (/_/);
# normal logins go through Authelia. setup.sh generates it.
BESZEL_ADMIN_EMAIL=
BESZEL_ADMIN_PASSWORD=

# oauth2-proxy's client secret for Authelia (the plain one; Authelia only has its digest)
# and the key for its session cookie. setup.sh generates both.
BESZEL_CLIENT_SECRET=
BESZEL_COOKIE_SECRET=

# The hub's public SSH key, which the agent accepts. setup.sh reads it from BESZEL_DATA_DIR.
BESZEL_AGENT_KEY=

# Only if the container can't resolve SERVER_NAME (see docker-compose.yml): tailscale ip -4
SERVER_TAILSCALE_IP=
