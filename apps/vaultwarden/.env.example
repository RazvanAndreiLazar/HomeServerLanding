# Copy to .env (scripts/setup.sh does this) and fill in. .env is never committed.

# The server's MagicDNS name (same as SERVER_NAME in gateway/.env)
SERVER_NAME=server.tailXXXX.ts.net

# Vaultwarden's Tailscale Service name (same tailnet part as SERVER_NAME)
VAULTWARDEN_HOST=vaultwarden.tailXXXX.ts.net

# Where Vaultwarden keeps its database (the encrypted vaults), attachments and keys
VAULTWARDEN_DATA_DIR=/srv/data/vaultwarden

# Vaultwarden's client secret for Authelia (the plain one; Authelia only has its digest).
# setup.sh generates it.
VAULTWARDEN_CLIENT_SECRET=

# Only if the container can't resolve SERVER_NAME (see docker-compose.yml): tailscale ip -4
SERVER_TAILSCALE_IP=
