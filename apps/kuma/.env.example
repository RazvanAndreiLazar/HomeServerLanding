# Copy to .env (scripts/setup.sh does this) and fill in. .env is never committed.

# The server's MagicDNS name (same as SERVER_NAME in gateway/.env)
SERVER_NAME=server.tailXXXX.ts.net

# Uptime Kuma's Tailscale Service name (same tailnet part as SERVER_NAME)
KUMA_HOST=kuma.tailXXXX.ts.net

# Where Kuma keeps its database (monitors, history, settings)
KUMA_DATA_DIR=/srv/data/kuma

# oauth2-proxy's client secret for Authelia (the plain one; Authelia only has its digest)
# and the key for its session cookie. setup.sh generates both.
KUMA_CLIENT_SECRET=
KUMA_COOKIE_SECRET=

# Only if the container can't resolve SERVER_NAME (see docker-compose.yml): tailscale ip -4
SERVER_TAILSCALE_IP=
